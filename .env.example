# Developer Control Plane Configuration
# Copy this file to .env and customize as needed

# Common Settings
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database (REQUIRED - Set secure values before starting)
POSTGRES_USER=backstage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=backstage

# Backstage Portal
BACKSTAGE_PORT=7007
APP_BASE_URL=http://localhost:7007
BACKEND_BASE_URL=http://localhost:7007

# Eclipse Che
CHE_PORT=8080
CHE_HOST=localhost
CHE_WORKSPACE_STORAGE=/che/workspaces

# Score Service
SCORE_API_PORT=8081
SCORE_WEBHOOK_PORT=8082
PIPELINE_TRIGGER_ENABLED=true

# API Gateway
GATEWAY_PORT=8000

# Plugin Manager
PLUGIN_MANAGER_PORT=8083
PLUGIN_REGISTRY_URL=

# Authentication (local mode)
AUTH_PROVIDER=local
