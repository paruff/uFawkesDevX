# Developer Control Plane Configuration
# Copy this file to .env and customize as needed

# Common Settings
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database (owned by uFawkesRes; REQUIRED - set secure values before starting)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=backstage

# Backstage DB password Docker secret (REQUIRED - set a secure value)
BACKSTAGE_DB_PASSWORD=changeme

# Backstage Portal
BACKSTAGE_PORT=7007
APP_BASE_URL=http://localhost:7007
BACKEND_BASE_URL=http://localhost:7007

# Coder - Cloud IDE / devcontainer workspace provisioner
CODER_PORT=7080
# Must be a LAN-reachable address, not localhost, for workspace agents to connect
CODER_ACCESS_URL=http://localhost:7080
CODER_DB_PASSWORD=changeme

# Host docker group GID (run `make check-gid` to get the value)
DOCKER_GID=999

# Score Service
SCORE_API_PORT=8081
SCORE_WEBHOOK_PORT=8082
PIPELINE_TRIGGER_ENABLED=true

# API Gateway
GATEWAY_PORT=8000

# Plugin Manager
PLUGIN_MANAGER_PORT=8083
PLUGIN_REGISTRY_URL=

# Authentication (local mode)
AUTH_PROVIDER=local
