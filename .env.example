# Developer Control Plane Configuration
# Copy this file to .env and customize as needed

# Common Settings
NODE_ENV=development
LOG_LEVEL=info

# Backstage Portal
BACKSTAGE_PORT=7007
APP_BASE_URL=http://localhost:7007
BACKEND_BASE_URL=http://localhost:7007

# Coder - Cloud IDE / devcontainer workspace provisioner
CODER_PORT=7080
# Must be a LAN-reachable address, not localhost, for workspace agents to connect
CODER_ACCESS_URL=http://localhost:7080

# Host docker group GID (run `make check-gid` to get the value)
DOCKER_GID=999

# Score Service
SCORE_API_PORT=8081
SCORE_WEBHOOK_PORT=8082
PIPELINE_TRIGGER_ENABLED=true
# Pipeline trigger, per uFawkesPipe's docs/pipeline-trigger-contract.md: a
# Woodpecker "create pipeline" call made when a spec is created/updated.
# PIPELINE_WEBHOOK_URL is the full URL, e.g. http://woodpecker:8000/api/repos/<repo-id>/pipelines;
# the token is a Woodpecker API token; the branch is the one to run.
# Leave the URL unset to disable (server.js logs a warning and skips the call;
# spec creation still succeeds).
PIPELINE_WEBHOOK_URL=
PIPELINE_WEBHOOK_TOKEN=
PIPELINE_BRANCH=main

# API Gateway
GATEWAY_PORT=8000

# Plugin Manager
PLUGIN_MANAGER_PORT=8083
PLUGIN_REGISTRY_URL=

# Authentication (local mode)
AUTH_PROVIDER=local
