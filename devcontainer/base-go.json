{
  "name": "Go 1.22",
  "image": "mcr.microsoft.com/devcontainers/go:1.22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install pre-commit && pre-commit install",
  "remoteUser": "vscode",
